+// SWARM compatibility extension. The original WRENCH license applies.
+#include <wrench/simulation/Simulation.h>
+#include <fsmod/FileSystem.hpp>
+#include <fsmod/Storage.hpp>
+#include <simgrid/s4u.hpp>
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace wrench {
+    void Simulation::registerExistingFileSystem(
+        const std::shared_ptr<simgrid::fsmod::FileSystem> &file_system,
+        const std::shared_ptr<simgrid::fsmod::Storage> &storage,
+        const std::string &mount_point) {
+        if (!initialized || already_setup)
+            throw std::invalid_argument("registerExistingFileSystem: register during platform creation");
+        existing_file_system_bindings.push_back({file_system, storage, mount_point});
+        try {
+            validateExistingFileSystems();
+        } catch (...) {
+            existing_file_system_bindings.pop_back();
+            throw;
+        }
+    }
+
+    std::set<simgrid::s4u::Disk *> Simulation::validateExistingFileSystems() const {
+        std::set<simgrid::s4u::Disk *> managed;
+        std::set<std::string> names;
+        const auto hosts = simgrid::s4u::Engine::get_instance()->get_all_hosts();
+        for (const auto &binding : existing_file_system_bindings) {
+            const auto &fs = binding.file_system;
+            const auto &storage = binding.storage;
+            if (!fs || !storage || binding.mount_point.empty() || binding.mount_point.front() != '/')
+                throw std::invalid_argument("FSMod binding requires filesystem, storage, and absolute mount path");
+            if (!names.insert(fs->get_name()).second)
+                throw std::invalid_argument("Duplicate FSMod filesystem registration: " + fs->get_name());
+            const auto partition = fs->get_partition_for_path_or_null(binding.mount_point);
+            auto normalized_mount = binding.mount_point;
+            while (normalized_mount.size() > 1 && normalized_mount.back() == '/') normalized_mount.pop_back();
+            if (!partition || fs->get_partitions().size() != 1 || partition->get_name() != normalized_mount ||
+                partition->get_size() == 0 || partition->get_free_space() > partition->get_size())
+                throw std::invalid_argument("Invalid FSMod partition/capacity: " + fs->get_name());
+            const auto disks = storage->get_disks();
+            if (disks.empty()) throw std::invalid_argument("FSMod storage has no backing disks");
+            simgrid::s4u::Host *owner = nullptr;
+            for (auto *disk : disks) {
+                if (!disk || !managed.insert(disk).second)
+                    throw std::invalid_argument("Null or multiply registered FSMod backing disk");
+                auto *host = disk->get_host();
+                if (std::find(hosts.begin(), hosts.end(), host) == hosts.end())
+                    throw std::invalid_argument("FSMod disk is not attached to this platform");
+                const auto host_disks = host->get_disks();
+                if (std::find(host_disks.begin(), host_disks.end(), disk) == host_disks.end())
+                    throw std::invalid_argument("FSMod disk is not attached to its host");
+                if (owner && owner != host)
+                    throw std::invalid_argument("This FSMod compatibility API requires one storage host per store");
+                owner = host;
+                if (!std::isfinite(disk->get_read_bandwidth()) || disk->get_read_bandwidth() <= 0 ||
+                    !std::isfinite(disk->get_write_bandwidth()) || disk->get_write_bandwidth() <= 0)
+                    throw std::invalid_argument("Invalid FSMod disk bandwidth: " + disk->get_name());
+            }
+            const auto &registered = simgrid::fsmod::FileSystem::get_file_systems_by_netzone(owner->get_englobing_zone());
+            const auto found = registered.find(fs->get_name());
+            if (found == registered.end() || found->second != fs)
+                throw std::invalid_argument("FSMod filesystem is not registered at its storage host zone");
+        }
+        return managed;
+    }
+}
